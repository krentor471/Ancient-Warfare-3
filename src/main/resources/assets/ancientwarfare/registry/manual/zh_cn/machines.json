    {
      "content_type": "heading",
      "text": "三 自动化机器",
      "level": 1
    },
    {
      "content_type": "text",
      "text": "点击下面的物品条目直接跳转。"
    },
    {
      "content_type": "toc_list",
      "items": [
        {
